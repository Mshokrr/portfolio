---
interface Props {
  items?: string[];
}

const {
  items = [
    "We're launching WAS. Check it out at instagram.com/was.local",
    'WAS - Modernizing Egyptian fashion heritage with a modern twist',
    'Stay tuned for the WAS online store.',
  ],
} = Astro.props;
---

<marquee width="100%" direction="left">
  {items.map((text) => <span>{text}</span>)}
</marquee>
