---
interface Props {
  title: string;
  subtitle?: string;
  versionNumber?: string;
}

const { title, subtitle = 'Pinned Issue', versionNumber = 'NO. 01' } = Astro.props;
---

<div class="blog-header blog-is-sticky">
  <div class="blog-article header-article">
    <div class="blog-big__title">{title}</div>
    <div class="blog-menu rounded small-title">{subtitle}</div>
  </div>
  <div class="blog-article page-number">
    {versionNumber}
  </div>
</div>
