---
interface Props {
  title?: string;
  subtitle?: string;
  cta?: string;
}

const {
  title = 'Get to know me',
  subtitle = "Reach out and let's have a chat.",
  cta = "Let's talk",
} = Astro.props;
---

<div class="circle">
  <div class="circle-title">{title}</div>
  <div class="circle-subtitle">{subtitle}</div>
  <div class="circle-footer"><a href="/contact">{cta}</a></div>
</div>
