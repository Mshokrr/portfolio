---
import { Sun, Moon } from '@lucide/astro';
---

<button type="button" class="theme-toggle" aria-label="Switch to dark theme">
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <Sun size={22} 'stroke-width={1.5} />
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <Moon size={22} 'stroke-width={1.5} />
  </span>
</button>

<style lang="scss">
  $duration: 0.4s;
  $easing: cubic-bezier(0.34, 1.3, 0.64, 1); // slight overshoot, settles quickly

  .theme-toggle {
    // Reset native button look
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    color: var(--color-text);

    &:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 2px;
      border-radius: 4px;
    }

    // Both icons share one grid cell, so they sit on top of each other
    &__icon {
      grid-area: 1 / 1;
      display: grid;
      place-items: center;
      transition:
        transform $duration $easing,
        opacity $duration ease;

      // Lucide renders width/height attributes in px; size it from the root font size instead
      :global(svg) {
        width: 1.375rem;
        height: 1.375rem;
        margin: 0; // cancel the .blog-menu svg margin when used inside the menu
      }
    }

    // Light theme (default): sun visible, moon tucked away
    &__icon--sun {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }

    &__icon--moon {
      opacity: 0;
      transform: rotate(-90deg) scale(0.4);
    }
  }

  // Dark theme: sun spins out, moon spins in
  :global([data-theme='dark']) .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }

  :global([data-theme='dark']) .theme-toggle__icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__icon {
      transition: opacity 0.01s;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'theme';

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    syncLabel();
  }

  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  // Keep the accessible name describing the action the button will perform
  function syncLabel() {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    document
      .querySelectorAll('.theme-toggle')
      .forEach((button) => button.setAttribute('aria-label', `Switch to ${next} theme`));
  }

  function themeFromStorageOrSystem() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return stored;
    } catch {}
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  // One delegated listener: keeps working if you add view transitions later
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.theme-toggle');
    if (!button) return;

    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(next);

    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage can be blocked (private mode); the theme still applies for this visit
    }
  });

  // Follow system changes only while the visitor hasn't picked a theme manually
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem(STORAGE_KEY)) return;
    } catch {
      return;
    }
    applyTheme(event.matches ? 'dark' : 'light');
  });

  // Only needed with Astro's <ClientRouter /> (view transitions):
  // re-apply the theme to the incoming document so it doesn't reset on navigation.
  document.addEventListener('astro:after-swap', () => {
    applyTheme(themeFromStorageOrSystem());
  });

  syncLabel();
</script>
