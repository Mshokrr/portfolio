---
// src/components/ThemeToggle.astro
// Requires the inline <head> script and [data-theme] variables from the theming setup.
---

<button type="button" class="theme-toggle" aria-label="Switch color theme">
  <svg
    class="theme-toggle__icon"
    viewBox="0 0 24 24"
    width="22"
    height="22"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="8.25"></circle>
    <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5Z" fill="currentColor" stroke="none"></path>
  </svg>
  <!-- <span class="theme-toggle__label theme-toggle__label--to-dark">Dark mode</span>
    <span class="theme-toggle__label theme-toggle__label--to-light">Light mode</span> -->
</button>

<style lang="scss">
  .theme-toggle {
    // Reset native button look so it inherits the menu typography
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-family: inherit;
    font-size: 19px;
    letter-spacing: -0.5px;
    color: var(--color-text);

    @media screen and (max-width: 1260px) {
      font-size: 1.4vw;
    }

    @media screen and (max-width: 1030px) {
      font-size: 19px;
    }

    &:focus-visible {
      outline: 2px solid var(--color-text);
      outline-offset: 4px;
      border-radius: 2px;
    }

    &:hover .theme-toggle__label {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    &__icon {
      flex: none;
      transition: transform 0.35s ease;
    }

    &__label {
      white-space: nowrap;
    }
  }

  // Show the label for the theme you'd switch TO.
  // Driven purely by CSS on <html data-theme>, so there's no flash on load.
  :global([data-theme='dark']) .theme-toggle__label--to-dark,
  :global(:root:not([data-theme='dark'])) .theme-toggle__label--to-light {
    display: none;
  }

  // Flip the half-filled circle in dark mode
  :global([data-theme='dark']) .theme-toggle__icon {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__icon {
      transition: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'theme';

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
  }

  function currentTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  // One delegated listener: keeps working if you add view transitions later
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.theme-toggle');
    if (!button) return;

    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(next);

    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Storage can be blocked (private mode); the theme still applies for this visit
    }
  });

  // Follow system changes only while the visitor hasn't picked a theme manually
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem(STORAGE_KEY)) return;
    } catch {
      return;
    }
    applyTheme(event.matches ? 'dark' : 'light');
  });

  // Only needed if you use Astro's <ClientRouter /> (view transitions):
  // re-apply the theme to the incoming document so it doesn't reset on navigation.
  document.addEventListener('astro:after-swap', () => {
    applyTheme(currentThemeFromStorage());
  });

  function currentThemeFromStorage() {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) return stored;
    } catch {}
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
</script>
