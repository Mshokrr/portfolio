---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { slugify } from '../../utils/slugify';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  // One page per slug; keep the first spelling of each tag as its display label
  const labels = new Map<string, string>();
  posts.forEach((p) =>
    p.data.tags.forEach((t) => labels.set(slugify(t), labels.get(slugify(t)) ?? t)),
  );

  return [...labels].map(([slug, tag]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.some((t) => slugify(t) === slug))
        .sort((a, b) => +b.data.date - +a.data.date),
    },
  }));
}

const { tag, posts } = Astro.props;
const fmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;
---

<PageLayout
  title={`#${tag}`}
  eyebrow="Tag"
  description={`${posts.length} essay${posts.length === 1 ? '' : 's'} tagged ${tag}.`}
>
  <p><a href="/blog">← All essays</a></p>
  <div class="post-list">
    {
      posts.map((post) => (
        <a
          class:list={['post-card', { 'post-card--no-cover': !post.data.cover }]}
          href={`/${post.data.type === 'work/career' ? 'career' : 'blog'}/${post.id}`}
        >
          {post.data.cover && (
            <div class="post-card__cover">
              <img src={post.data.cover} alt="" loading="lazy" />
            </div>
          )}
          <div>
            <div class="post-card__meta">
              {fmt(post.data.date)} · {post.data.author}
            </div>
            <h2 class="post-card__title">{post.data.bigTitle}</h2>
            <p class="post-card__excerpt">{post.data.excerpt}</p>
          </div>
        </a>
      ))
    }
  </div>
</PageLayout>
