---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { entryPeriod } from '../../utils/format';

const workItems = (
  await getCollection(
    'posts',
    ({ data }) => !data.draft && !data.hidden && data.type === 'work/career',
  )
).sort((a, b) => +b.data.date - +a.data.date);

const renderHeadline = (headline: string, emphasis?: string) => {
  if (!emphasis) return headline;
  return headline.replace('{emphasis}', `__${emphasis}__`);
};
---

<PageLayout title="Career" eyebrow="Career" description="">
  <div class="post-list">
    {
      workItems.map((post) => {
        const parts = renderHeadline(post.data.headline, post.data.emphasis).split('__');
        return (
          <a
            class:list={['post-card', { 'post-card--no-cover': !post.data.cover }]}
            href={`/career/${post.id}`}
          >
            {post.data.cover && (
              <div class="post-card__cover">
                <img src={post.data.cover} alt="" loading="lazy" />
              </div>
            )}
            <div>
              <div class="post-card__meta">
                {[entryPeriod(post.data), post.data.author, post.data.annotation]
                  .filter(Boolean)
                  .join(' · ')}
              </div>
              <h2 class="post-card__title">
                {parts.map((part, i) => (i % 2 === 1 ? <span>{part}</span> : <>{part}</>))}
              </h2>
              <p class="post-card__excerpt">{post.data.excerpt}</p>
              {post.data.tags.length > 0 && (
                <div class="post-card__tags">
                  {post.data.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</PageLayout>
